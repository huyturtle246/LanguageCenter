@model LanguageCenter.Models.Program
@{
    ViewBag.Title = "Thêm mới chương trình học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <div class="form-header">
        <div class="header-title">
            <h2><i class="fa-solid fa-folder-plus"></i> Thêm mới chương trình học</h2>
        </div>
        <div class="header-action">
            @Html.ActionLink("Quay lại danh sách", "Index", "AdminProgram", null, new { @class = "btn-back" })
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @* --- KHỐI UPLOAD ẢNH BANNER ĐỒNG BỘ Y HỆT EDIT --- *@
        <div class="avatar-upload-section">
            <div class="avatar-preview-box">
                @if (Model != null && !string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" id="pictureUpload" alt="Program Image" />
                }
                else
                {
                    <img src="https://placehold.co/150x150/f1f5f9/64748b?text=No+Image" id="pictureUpload" alt="Program Image" />
                }
            </div>

            <div class="avatar-upload-buttons">
                <input type="file" name="fileUpload" id="fileUpload" accept="image/*" style="display:none;" />
                <button type="button" id="btnUpload" class="btn-select-image">
                    <i class="fa-solid fa-camera"></i> Chọn ảnh khóa học
                </button>
                @Html.HiddenFor(model => model.Image, new { id = "image" })
                @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger", style = "display:block;" })
            </div>
        </div>

        @* Bố cục Grid phân bổ đều 2 cột cân bằng *@
        <div class="form-grid-content">

            @* --- CỘT TRÁI --- *@
            <div class="grid-column-left">
                <div class="form-group">
                    @Html.LabelFor(model => model.Program_Name, "Tên chương trình học", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-book input-icon"></i>
                        @Html.EditorFor(model => model.Program_Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên chương trình học..." } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Program_Name, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.DurationWeeks, "Thời gian học (Tuần)", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-regular fa-clock input-icon"></i>
                        @Html.EditorFor(model => model.DurationWeeks, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập số tuần học...", type = "number" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.DurationWeeks, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Description, "Mô tả khóa học", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-align-left input-icon-textarea"></i>
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control-textarea", placeholder = "Nhập tóm tắt mô tả nội dung khóa học...", rows = "5" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                </div>
            </div>

            @* --- CỘT PHẢI --- *@
            <div class="grid-column-right">
                <div class="form-group">
                    @Html.LabelFor(model => model.Level, "Cấp độ / Trình độ", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-layer-group input-icon"></i>
                        @Html.EditorFor(model => model.Level, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: A1 - A2, B2 - C1..." } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Level, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Price, "Học phí (VNĐ)", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-hand-holding-dollar input-icon"></i>
                        @Html.EditorFor(model => model.Price, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập học phí...", type = "number", step = "0.01" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Output_Standard, "Chuẩn đầu ra", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-graduation-cap input-icon-textarea"></i>
                        @Html.TextAreaFor(model => model.Output_Standard, new { @class = "form-control-textarea", placeholder = "Học viên sẽ đạt được gì sau khóa học...", rows = "5" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Output_Standard, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-plus"></i> Thêm chương trình
            </button>
        </div>
    }
</div>

@section scripts
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            // Click nút chọn ảnh giả lập
            $('#btnUpload').click(function () {
                $('#fileUpload').trigger('click');
            });

            // Xử lý sự kiện thay đổi file và gửi AJAX
            $('#fileUpload').change(function () {
                if (window.FormData !== undefined) {
                    var fileUpload = $('#fileUpload').get(0);
                    var files = fileUpload.files;
                    if (files.length > 0) {
                        var formData = new FormData();
                        formData.append('file', files[0]);

                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("ProcessUpload", "AdminProgram")',
                            contentType: false,
                            processData: false,
                            data: formData,
                            success: function (urlImage) {
                                if (urlImage !== "") {
                                    // Thay đổi nguồn src của ảnh xem trước và gán link vào input hidden
                                    $('#pictureUpload').attr('src', urlImage);
                                    $('#image').val(urlImage);
                                } else {
                                    alert('Tải ảnh thất bại, vui lòng thử lại!');
                                }
                            },
                            error: function (err) {
                                alert('Đã xảy ra lỗi: ' + err.statusText);
                            }
                        });
                    }
                } else {
                    alert('Trình duyệt của bạn không hỗ trợ FormData!');
                }
            });
        });
    </script>
}

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #334155;
        margin: 0;
        padding: 30px 20px;
    }

    .form-container {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .header-title h2 {
        margin: 0;
        font-size: 22px;
        color: #1e293b;
        font-weight: 700;
    }

    .avatar-upload-section {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 35px;
        background-color: #f8fafc;
        padding: 20px;
        border-radius: 12px;
        border: 1px dashed cornflowerblue;
    }

    .avatar-preview-box {
        width: 130px;
        height: 130px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #cbd5e1;
        background-color: #fff;
    }

        .avatar-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .btn-select-image {
        background-color: cornflowerblue;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

        .btn-select-image:hover {
            background-color: #5386ed;
        }

    .form-grid-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 40px;
    }

    .grid-column-left, .grid-column-right {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 16px;
    }

    .input-icon-textarea {
        position: absolute;
        left: 14px;
        top: 14px;
        color: #94a3b8;
        font-size: 16px;
    }

    .form-control {
        width: 100%;
        padding: 12px 12px 12px 42px;
        font-family: inherit;
        font-size: 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .form-control-textarea {
        width: 100%;
        padding: 12px 12px 12px 42px;
        font-family: inherit;
        font-size: 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
        resize: none;
    }

        .form-control:focus, .form-control-textarea:focus {
            outline: none;
            border-color: cornflowerblue;
            box-shadow: 0 0 0 4px rgba(100, 149, 237, 0.15);
        }

    .text-danger {
        font-size: 12px;
        color: #ef4444;
        margin-top: 5px;
    }

    .form-actions {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }

    .btn-submit {
        background-color: cornflowerblue;
        color: white;
        border: none;
        padding: 12px 24px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-submit:hover {
            background-color: #5386ed;
        }

    .btn-back {
        text-decoration: none;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
    }

        .btn-back:hover {
            background-color: #f1f5f9;
            color: #334155;
        }
</style>