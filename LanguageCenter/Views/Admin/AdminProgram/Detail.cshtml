@model LanguageCenter.Models.Program
@{
    ViewBag.Title = "Chi tiết chương trình học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    @* --- HEADER TRANG --- *@
    <div class="form-header">
        <div class="header-title">
            <h2><i class="fa-solid fa-circle-info"></i> Chi tiết chương trình học</h2>
        </div>
        <div class="header-action">
            @Html.ActionLink("Quay lại danh sách", "Index", "AdminProgram", null, new { @class = "btn-back" })
        </div>
    </div>

    @* --- KHỐI BANNER THÔNG TIN NHANH (ẢNH & TÊN CHƯƠNG TRÌNH) --- *@
    <div class="detail-banner-section">
        <div class="detail-image-box">
            @if (Model != null && !string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" alt="@Model.Program_Name" />
            }
            else
            {
                <img src="https://placehold.co/150x150/f1f5f9/64748b?text=No+Image" alt="No Image Available" />
            }
        </div>

        <div class="detail-main-info">
            <span class="info-badge"><i class="fa-solid fa-graduation-cap"></i> Khóa học hệ thống</span>
            <h1 class="program-main-title">@(Model != null ? Model.Program_Name : "Chưa cập nhật tên")</h1>
        </div>
    </div>

    @* --- BỐ CỤC GRID THÔNG TIN CHI TIẾT --- *@
    <div class="form-grid-content">

        @* --- CỘT TRÁI --- *@
        <div class="grid-column-left">
            <div class="detail-group">
                <span class="detail-label"><i class="fa-regular fa-clock"></i> Thời gian đào tạo</span>
                <div class="detail-value-box">
                    <span>@(Model != null ? Model.DurationWeeks + " Tuần" : "Chưa xếp lịch")</span>
                </div>
            </div>

            <div class="detail-group">
                <span class="detail-label"><i class="fa-solid fa-layer-group"></i> Cấp độ / Trình độ</span>
                <div class="detail-value-box">
                    <span>@(Model != null && !string.IsNullOrEmpty(Model.Level) ? Model.Level : "Chưa phân cấp")</span>
                </div>
            </div>

            <div class="detail-group">
                <span class="detail-label"><i class="fa-solid fa-align-left"></i> Mô tả khóa học</span>
                <div class="detail-value-box textarea-display">
                    @if (Model != null && !string.IsNullOrEmpty(Model.Description))
                    {
                        @Html.Raw(Model.Description.Replace("\n", "<br />"))
                    }
                    else
                    {
                        <span class="text-muted">Chưa có thông tin mô tả chi tiết cho chương trình học này.</span>
                    }
                </div>
            </div>
        </div>

        @* --- CỘT PHẢI --- *@
        <div class="grid-column-right">
            <div class="detail-group">
                <span class="detail-label"><i class="fa-solid fa-hand-holding-dollar"></i> Giá trị học phí</span>
                <div class="detail-value-box fee-highlight">
                    <span>@(Model != null && Model.Price.HasValue ? String.Format("{0:N0} VNĐ", Model.Price.Value) : "Miễn phí / Chưa cấu hình")</span>
                </div>
            </div>

            <div class="detail-group">
                <span class="detail-label"><i class="fa-solid fa-award"></i> Chuẩn đầu ra (Cam kết)</span>
                <div class="detail-value-box textarea-display">
                    @if (Model != null && !string.IsNullOrEmpty(Model.Output_Standard))
                    {
                        @Html.Raw(Model.Output_Standard.Replace("\n", "<br />"))
                    }
                    else
                    {
                        <span class="text-muted">Chưa thiết lập chuẩn đầu ra cụ thể.</span>
                    }
                </div>
            </div>
        </div>

    </div>

    @* --- KHỐI ĐIỀU HƯỚNG CUỐI TRANG --- *@
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #334155;
        margin: 0;
        padding: 30px 20px;
    }

    .form-container {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .header-title h2 {
        margin: 0;
        font-size: 22px;
        color: #1e293b;
        font-weight: 700;
    }

    /* Khối banner chứa ảnh và thông tin tổng quan */
    .detail-banner-section {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 35px;
        background-color: #f8fafc;
        padding: 25px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .detail-image-box {
        width: 140px;
        height: 140px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #cbd5e1;
        background-color: #fff;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        flex-shrink: 0;
    }

        .detail-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .detail-main-info {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .info-badge {
        background-color: rgba(100, 149, 237, 0.15);
        color: #3b82f6;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        width: fit-content;
    }

    .program-main-title {
        margin: 0;
        font-size: 24px;
        font-weight: 700;
        color: #1e293b;
    }

    .program-id-text {
        margin: 0;
        font-size: 13px;
        color: #64748b;
    }

    /* Bố cục Grid hệ thống */
    .form-grid-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 40px;
    }

    .grid-column-left, .grid-column-right {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .detail-group {
        display: flex;
        flex-direction: column;
    }

    .detail-label {
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .detail-label i {
            margin-right: 4px;
            color: #94a3b8;
        }

    /* Ô hiển thị thông tin tĩnh dạng Disabled-view */
    .detail-value-box {
        width: 100%;
        padding: 12px 16px;
        font-size: 15px;
        font-weight: 500;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        box-sizing: border-box;
        min-height: 46px;
        display: flex;
        align-items: center;
    }

        /* Định dạng riêng cho ô hiển thị Văn bản dài (Mô tả, Chuẩn đầu ra) */
        .detail-value-box.textarea-display {
            align-items: flex-start;
            min-height: 120px;
            line-height: 1.6;
            display: block;
            overflow-wrap: break-word;
            font-weight: 400;
            color: #334155;
        }

    /* Làm nổi bật ô học phí */
    .fee-highlight {
        color: #0f172a;
        font-weight: 700;
        background-color: #fff7ed;
        border-color: #ffedd5;
        font-size: 16px;
    }

    .text-muted {
        color: #94a3b8;
        font-style: italic;
    }

    .form-actions {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }

    /* Nút hướng sang trang Sửa */
    .btn-edit-redirect {
        text-decoration: none;
        background-color: cornflowerblue;
        color: white;
        padding: 12px 24px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
        box-shadow: 0 2px 4px rgba(100, 149, 237, 0.2);
    }

        .btn-edit-redirect:hover {
            background-color: #5386ed;
            box-shadow: 0 4px 8px rgba(100, 149, 237, 0.3);
        }

    .btn-back {
        text-decoration: none;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
    }

        .btn-back:hover {
            background-color: #f1f5f9;
            color: #334155;
        }
</style>