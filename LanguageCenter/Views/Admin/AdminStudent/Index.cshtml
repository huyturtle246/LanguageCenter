@model IEnumerable<LanguageCenter.Models.Student>
@{
    ViewBag.Title = "Quản Lý Học Sinh";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="admin-box">
    <div class="page-header">
        <h2><i class="fa-solid fa-graduation-cap"></i> Danh Sách Học Sinh</h2>
        <a href="@Url.Action("Create")" class="btn-create-new">
            <i class="fa-solid fa-plus"></i> Thêm học sinh mới
        </a>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 20%;">Họ và tên</th>
                    <th style="width: 10%;" class="text-center">Giới tính</th>
                    <th style="width: 15%;" class="text-center">Ngày sinh</th>
                    <th style="width: 15%;">Số điện thoại</th>
                    <th style="width: 15%;" class="text-center">Trạng thái</th>
                    <th style="width: 15%;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong class="student-name">@item.Student_Name</strong></td>
                        <td class="text-center">
                            @if (item.Gender?.Trim().ToLower() == "nam" || item.Gender?.Trim() == "1")
                            {
                                <span class="badge-gender gender-male"><i class="fa-solid fa-mars"></i> Nam</span>
                            }
                            else if (item.Gender?.Trim().ToLower() == "nữ" || item.Gender?.Trim() == "2")
                            {
                                <span class="badge-gender gender-female"><i class="fa-solid fa-venus"></i> Nữ</span>
                            }
                        </td>
                        <td class="text-center text-muted font-weight-bold">
                            @(item.DOB != null ? item.DOB.Value.ToString("dd/MM/yyyy") : "N/A")
                        </td>
                        <td class="font-weight-bold">@item.Phone</td>

                        @* --- HIỂN THỊ TRẠNG THÁI TÀI KHOẢN --- *@
                        <td class="text-center">
                            @if (item.UserAccount != null)
                            {
                                <span class="status-badge @(item.UserAccount.isActive ? "active" : "locked")">
                                    @(item.UserAccount.isActive ? "Hoạt động" : "Đã khóa")
                                </span>
                            }
                            else
                            {
                                <span class="status-badge locked">Chưa có TK</span>
                            }
                        </td>

                        <td class="text-center action-buttons">
                            <a href="@Url.Action("Edit", new { id = item.Student_ID })" class="btn-action btn-edit" title="Chỉnh sửa"><i class="fa-solid fa-pen-to-square"></i></a>
                            <a href="@Url.Action("Detail", new { id = item.Student_ID })" class="btn-action btn-details" title="Xem chi tiết"><i class="fa-solid fa-eye"></i></a>
                            <a href="@Url.Action("Delete", new { id = item.Student_ID })" class="btn-action btn-delete" title="Xóa"><i class="fa-solid fa-trash-can"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<style>
    /* Bổ sung style cho Status Badge */
    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        display: inline-block;
    }

        .status-badge.active {
            background: #dcfce7;
            color: #166534;
            border: 1px solid #bbf7d0;
        }

        .status-badge.locked {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
        }

    /* Các style cũ giữ nguyên ... */
    .admin-box {
        border: 1px solid cornflowerblue;
        padding: 30px;
        margin-top: 30px;
        border-radius: 20px;
        background-color: #fff;
        box-shadow: 0 4px 15px rgba(100, 149, 237, 0.05);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid aliceblue;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

        .page-header h2 {
            color: cornflowerblue;
            margin: 0;
            font-size: 24px;
            font-weight: bold;
        }

    .back-zone {
        margin-top: 20px;
        text-align: left;
    }

    .btn-back-dashboard {
        color: #666;
        text-decoration: none;
        font-size: 14px;
        transition: 0.2s;
        border-radius: 50px;
        border: 1px solid cornflowerblue;
        text-align: center;
        padding: 10px 20px;
        display: inline-block;
        background-color: white;
    }

        .btn-back-dashboard:hover {
            color: cornflowerblue;
            background-color: aliceblue;
            border-color: cornflowerblue;
        }
    .btn-create-new {
        background-color: cornflowerblue;
        color: white !important;
        padding: 10px 20px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        font-size: 14px;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

        .admin-table th {
            background-color: aliceblue;
            padding: 15px 12px;
        }

        .admin-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #eef1f6;
        }

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        text-decoration: none !important;
        margin: 0 4px;
    }

    .btn-edit {
        background-color: #fff3cd;
        color: #856404;
    }

    .btn-details {
        background-color: #cce5ff;
        color: #004085;
    }

    .btn-delete {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>