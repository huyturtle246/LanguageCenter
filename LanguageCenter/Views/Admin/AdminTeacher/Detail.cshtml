@model LanguageCenter.Models.Teacher
@{
    ViewBag.Title = "Chi tiết giáo viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <div class="form-header">
        <div class="header-title">
            <h2><i class="fa-solid fa-address-card"></i> Thông tin chi tiết giáo viên</h2>
        </div>
        <div class="header-action">
            <a href="@Url.Action("Index", "AdminTeacher")" class="btn-action-custom">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    @* --- AVATAR & TÓM TẮT --- *@
    <div class="avatar-view-section">
        <div class="avatar-preview-box">
            @if (Model.UserAccount != null && !string.IsNullOrEmpty(Model.UserAccount.Image))
            {
                <img src="@Model.UserAccount.Image" alt="Avatar" />
            }
            else
            {
                <img src="https://placehold.co/150x150/f1f5f9/64748b?text=No+Image" alt="Avatar" />
            }
        </div>
        <div class="teacher-meta">
            <h3>@Model.Teacher_Name</h3>
            <p><i class="fa-solid fa-envelope"></i> @(Model.UserAccount?.Email ?? "Chưa cập nhật")</p>
        </div>
    </div>

    @* --- THÔNG TIN CÁ NHÂN --- *@
    <h3 class="section-title"><i class="fa-solid fa-circle-info"></i> Thông tin hồ sơ</h3>
    <div class="detail-grid">
        <div class="detail-item">
            <label>Số điện thoại</label>
            <div class="detail-value">@Model.Phone</div>
        </div>
        <div class="detail-item">
            <label>Giới tính</label>
            <div class="detail-value">@(Model.Gender ?? "N/A")</div>
        </div>
        <div class="detail-item">
            <label>Ngày sinh</label>
            <div class="detail-value">@(Model.DOB.HasValue ? Model.DOB.Value.ToString("dd/MM/yyyy") : "N/A")</div>
        </div>
        <div class="detail-item">
            <label>Mức lương</label>
            <div class="detail-value">@string.Format("{0:N0} VNĐ", Model.Salary)</div>
        </div>
        <div class="detail-item">
            <label>Bằng cấp</label>
            <div class="detail-value">@(Model.Certificate ?? "Chưa cập nhật")</div>
        </div>
        <div class="detail-item">
            <label>Địa chỉ</label>
            <div class="detail-value">@(Model.Address ?? "Chưa cập nhật")</div>
        </div>
    </div>

    @* --- TÀI KHOẢN HỆ THỐNG --- *@
    <h3 class="section-title"><i class="fa-solid fa-shield-halved"></i> Thông tin hệ thống</h3>
    <div class="detail-grid">
        @if (Model.UserAccount != null)
        {
            <div class="detail-item">
                <label>Tên đăng nhập</label>
                <div class="detail-value"><strong>@Model.UserAccount.User_Name</strong></div>
            </div>
            <div class="detail-item">
                <label>Mật khẩu</label>
                <div class="detail-value"><code>@Model.UserAccount.Password</code></div>
            </div>
            <div class="detail-item">
                <label>Trạng thái</label>
                <div class="detail-value">
                    <span class="status-badge @(Model.UserAccount.isActive ? "active" : "locked")">
                        @(Model.UserAccount.isActive ? "Đang hoạt động" : "Đã khóa")
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="detail-item full-width">
                <p class="no-data"><i class="fa-solid fa-triangle-exclamation"></i> Giáo viên hiện chưa được cấp tài khoản hệ thống.</p>
            </div>
        }
    </div>
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #334155;
        padding: 30px 20px;
    }

    .form-container {
        max-width: 800px;
        margin: 0 auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 25px;
    }

    .header-title h2 {
        margin: 0;
        font-size: 22px;
        color: #1e293b;
        font-weight: 700;
    }

    .btn-action-custom {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background-color: #f1f5f9;
        color: #475569;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        border: 1px solid #e2e8f0;
        transition: 0.2s;
    }

        .btn-action-custom:hover {
            background-color: #e2e8f0;
            color: #1e293b;
        }

    .section-title {
        font-size: 16px;
        color: cornflowerblue;
        border-left: 4px solid cornflowerblue;
        padding-left: 10px;
        margin: 30px 0 15px 0;
        font-weight: 700;
    }

    .avatar-view-section {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .avatar-preview-box {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid cornflowerblue;
    }

        .avatar-preview-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .teacher-meta h3 {
        margin: 0;
        color: #1e293b;
    }

    .teacher-meta p {
        color: #64748b;
        margin: 5px 0 0 0;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        background: #f8fafc;
        padding: 20px;
        border-radius: 12px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
    }

        .detail-item label {
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

    .detail-value {
        font-size: 15px;
        color: #334155;
        font-weight: 500;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

        .status-badge.active {
            background: #dcfce7;
            color: #166534;
        }

        .status-badge.locked {
            background: #fee2e2;
            color: #991b1b;
        }
</style>