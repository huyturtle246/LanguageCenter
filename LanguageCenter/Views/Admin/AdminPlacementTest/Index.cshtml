@model IEnumerable<LanguageCenter.Models.PlacementTest>
@{
    ViewBag.Title = "Quản lý Lịch Thi Xếp Lớp";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="table-container">
    <div class="table-header">
        <div class="header-title">
            <h2><i class="fa-solid fa-calendar-check"></i> Quản lý lịch thi & kết quả xếp lớp</h2>
        </div>
        <div class="header-action">
            <a href="@Url.Action("Create", "AdminPlacementTest")" class="btn-add-new">
                <i class="fa-solid fa-plus"></i> Tạo lịch thi mới
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã số</th>
                    <th>Họ tên học viên</th>
                    <th>Số điện thoại</th>
                    <th>Ngày thi</th>
                    <th>Điểm số</th>
                    <th>Xếp lớp gợi ý</th>
                    <th>Trạng thái</th>
                    <th>Ghi chú đánh giá</th>
                    <th style="width: 140px; text-align: center;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-bold">#@item.Test_ID</td>
                        <td>
                            <span class="user-name">@(item.Student != null ? item.Student.Student_Name : "N/A")</span>
                        </td>
                        <td>@(item.Student != null ? item.Student.Phone : "---")</td>
                        <td>
                            @(item.TestDate.HasValue ? item.TestDate.Value.ToString("dd/MM/yyyy") : "---")
                        </td>
                        <td class="text-bold text-score">
                            @(item.Score.HasValue ? item.Score.Value.ToString("0.00") : "---")
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ResultLevel))
                            {
                                <span class="badge-level">@item.ResultLevel</span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa xếp</span>
                            }
                        </td>
                        <td>
                            @if (item.Score.HasValue)
                            {
                                <span class="status-badge success"><i class="fa-solid fa-square-poll-horizontal"></i> Hoàn thành</span>
                            }
                            else
                            {
                                <span class="status-badge warning"><i class="fa-solid fa-hourglass-half"></i> Chờ thi</span>
                            }
                        </td>
                        <td class="text-notes" title="@item.Notes">
                            @(string.IsNullOrEmpty(item.Notes) ? "---" : item.Notes)
                        </td>
                        <td class="text-center">
                            <div class="action-buttons">
                                <a href="@Url.Action("Edit", "AdminPlacementTest", new { id = item.Test_ID })" class="btn-action edit" title="Cập nhật kết quả">
                                    <i class="fa-solid fa-marker"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #334155;
        margin: 0;
        padding: 30px 20px;
    }

    .table-container {
        max-width: 1250px;
        margin: 0 auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 25px;
    }

    .header-title h2 {
        margin: 0;
        font-size: 22px;
        color: #1e293b;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .header-title i {
        color: cornflowerblue;
    }

    .btn-add-new {
        text-decoration: none;
        background-color: cornflowerblue;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

        .btn-add-new:hover {
            background-color: #5386ed;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 15px;
    }

        .custom-table th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
            padding: 16px;
            border-bottom: 2px solid #e2e8f0;
            text-align: left;
        }

        .custom-table td {
            padding: 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    .text-bold {
        font-weight: 600;
        color: #1e293b;
    }

    .text-score {
        color: #2563eb;
        font-size: 16px;
    }

    .user-name {
        font-weight: 500;
        color: #0f172a;
    }

    .text-notes {
        color: #64748b;
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .text-muted {
        color: #cbd5e1;
        font-style: italic;
    }

    .badge-level {
        background-color: #eff6ff;
        color: #2563eb;
        padding: 4px 10px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        border: 1px solid #bfdbfe;
    }

    /* Badges tự động tính theo Score */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

        .status-badge.success {
            background-color: #ecfdf5;
            color: #10b981;
        }

        .status-badge.warning {
            background-color: #fffbeb;
            color: #f59e0b;
        }

    .text-center {
        text-align: center;
    }

    .btn-action.edit {
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 6px;
        background-color: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
        transition: 0.2s;
    }

        .btn-action.edit:hover {
            background-color: #2563eb;
            color: white;
        }
</style>