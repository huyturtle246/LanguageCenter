@model LanguageCenter.Models.Class
@{
    ViewBag.Title = "Chỉnh sửa thông tin lớp học";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Sử dụng chung Layout hệ thống của bạn
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="form-container">
    <div class="form-header">
        <div class="header-title">
            <h2><i class="fa-solid fa-school"></i> Chỉnh sửa thông tin lớp học</h2>
        </div>
        <div class="header-action">
            @Html.ActionLink("Quay lại danh sách", "Index", "AdminClass", null, new { @class = "btn-back" })
        </div>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Class_ID) @* Giữ ID ẩn để không lỗi khi Submit *@

        @* Bố cục Grid phân bổ đều 2 cột cân bằng tuyệt đối *@
        <div class="form-grid-content">

            @* --- CỘT TRÁI --- *@
            <div class="grid-column-left">
                <div class="form-group">
                    @Html.LabelFor(model => model.Class_Name, "Tên lớp học", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-graduation-cap input-icon"></i>
                        @Html.EditorFor(model => model.Class_Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên lớp học (Ví dụ: Lớp IELTS - C1)..." } })
                    </div>
                    @Html.ValidationMessageFor(model => model.Class_Name, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Program_ID, "Chương trình học", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-book input-icon"></i>
                        @* Đã sửa thành DropDownListFor để tự động chọn đúng dữ liệu đã đọc lên từ Database *@
                        @Html.DropDownListFor(model => model.Program_ID, (SelectList)ViewBag.ProgramList, "-- Chọn chương trình học --", new { @class = "form-control-select" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Program_ID, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.StartDate, "Ngày bắt đầu", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-regular fa-calendar-plus input-icon"></i>
                        @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                </div>
            </div>

            @* --- CỘT PHẢI --- *@
            <div class="grid-column-right">
                <div class="form-group">
                    @Html.LabelFor(model => model.MaxStudents, "Số học viên tối đa", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-users input-icon"></i>
                        @Html.EditorFor(model => model.MaxStudents, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập sĩ số tối đa...", type = "number" } })
                    </div>
                    @Html.ValidationMessageFor(model => model.MaxStudents, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Teacher_ID, "Giáo viên phụ trách", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user-tie input-icon"></i>
                        @* Đã sửa thành DropDownListFor nhằm map chính xác Id Giáo viên đang quản lý *@
                        @Html.DropDownListFor(model => model.Teacher_ID, (SelectList)ViewBag.TeacherList, "-- Chọn giáo viên phụ trách --", new { @class = "form-control-select" })
                    </div>
                    @Html.ValidationMessageFor(model => model.Teacher_ID, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.EndDate, "Ngày kết thúc", htmlAttributes: new { @class = "form-label" })
                    <div class="input-wrapper">
                        <i class="fa-regular fa-calendar-minus input-icon"></i>
                        @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    </div>
                    @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                </div>
            </div>

        </div>

        @* Trạng thái lớp học hiển thị chiếm trọn chiều rộng hàng dưới để tạo điểm nhấn *@
        <div class="form-group status-row">
            @Html.LabelFor(model => model.Status_ID, "Trạng thái lớp học", htmlAttributes: new { @class = "form-label" })
            <div class="input-wrapper">
                <i class="fa-solid fa-toggle-on input-icon"></i>
                @* Đã sửa thành DropDownListFor định danh trạng thái chuẩn chỉnh *@
                @Html.DropDownListFor(model => model.Status_ID, (SelectList)ViewBag.StatusList, "-- Chọn trạng thái lớp --", new { @class = "form-control-select" })
            </div>
            @Html.ValidationMessageFor(model => model.Status_ID, "", new { @class = "text-danger" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
            </button>
        </div>
    }
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #334155;
        margin: 0;
        padding: 30px 20px;
    }

    .form-container {
        max-width: 850px;
        margin: 0 auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .header-title h2 {
        margin: 0;
        font-size: 22px;
        color: #1e293b;
        font-weight: 700;
    }

    .form-grid-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 40px;
    }

    .grid-column-left, .grid-column-right {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .status-row {
        margin-top: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        color: #94a3b8;
        font-size: 16px;
        pointer-events: none;
    }

    .form-control {
        width: 100%;
        padding: 12px 12px 12px 42px;
        font-family: inherit;
        font-size: 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
    }

    .form-control-select {
        width: 100%;
        padding: 12px 12px 12px 42px;
        font-family: inherit;
        font-size: 15px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-sizing: border-box;
        background-color: #fff;
        color: #334155;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='%2394a3b8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
        background-repeat: no-repeat;
        background-position: right 14px center;
        background-size: 16px;
    }

        .form-control:focus, .form-control-select:focus {
            outline: none;
            border-color: cornflowerblue;
            box-shadow: 0 0 0 4px rgba(100, 149, 237, 0.15);
        }

    .text-danger {
        font-size: 12px;
        color: #ef4444;
        margin-top: 5px;
    }

    .form-actions {
        margin-top: 35px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        display: flex;
        justify-content: flex-end;
    }

    .btn-submit {
        background-color: cornflowerblue;
        color: white;
        border: none;
        padding: 12px 24px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-submit:hover {
            background-color: #5386ed;
        }

    .btn-back {
        text-decoration: none;
        color: #64748b;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
    }

        .btn-back:hover {
            background-color: #f1f5f9;
            color: #334155;
        }
</style>