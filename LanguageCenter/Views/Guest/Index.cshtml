@model LanguageCenter.Models.Guest_HomeView

@{
    ViewBag.Title = "Index";
}

<body>
    @*Header*@
    <div class="header">
        <img class="banner" src="~/Content/images/Gemini_Generated_Image_dzdy8jdzdy8jdzdy.png" />
    </div>

    @*About*@
    <div class="content">
        <div class="title-spacing">
            <h2>Global Connect</h2>
            <h2>Hệ thống anh ngữ quốc tế</h2>
        </div>
        <div class="blue-line"></div>

        <div class="introduce-1">
            <div>
                <p style="text-align: left;">
                    Được thành lập từ năm 2000, Global Connect tự hào là hệ thống Anh ngữ quốc tế hàng đầu, chuyên cung cấp các chương trình
                    đào tạo chuẩn toàn cầu với trọng tâm là bứt phá chứng chỉ IELTS và nâng cao tư duy ngôn ngữ học thuật. Với đội ngũ 100% giáo
                    viên bản xứ giàu kinh nghiệm kết hợp cùng lộ trình cá nhân hóa và phương pháp tương tác phản xạ tự nhiên, chúng tôi cam kết
                    đồng hành cùng học viên trên hành trình xóa bỏ rào cản ngôn ngữ, tự tin kết nối văn hóa và mở lối thành công trong tương lai.
                </p>
            </div>

            <div>
                <img class="introduce-picture" src="~/Content/images/Introduce.png" />
            </div>
        </div>

        <div class="introduce-2">
            <div class="introduce-border-banner">
                <img class="introduce-picture-banner" src="~/Content/images/Introduce1.png" />
                <h4>36 Chi nhánh toàn quốc</h4>
            </div>

            <div class="introduce-border-banner">
                <img class="introduce-picture-banner" src="~/Content/images/Introduce2.png" />
                <h4>18000+ Học viên theo học</h4>
            </div>

            <div class="introduce-border-banner">
                <img class="introduce-picture-banner" src="~/Content/images/Introduce3.png" />
                <h4>1000+ Giáo viên có bằng cấp</h4>
            </div>

            <div class="introduce-border-banner">
                <img class="introduce-picture-banner" src="~/Content/images/Introduce4.png" />
                <h4>100% Đạt điểm IETLS cao</h4>
            </div>
        </div>
    </div>

    @*Program*@
    <div class="content">
        <div class="title-spacing"><h2>Chương trình học tiếng anh tại Global Connect</h2></div>
        <p>Chúng tôi luôn có các chương trình tiếng anh đáp ứng nhu cầu của học viên ở mọi cấp độ</p>
        <div class="blue-line"></div>

        <div class="introduce-3">
            @foreach (var item in Model.ProgramList) 
            { 
                <div class="program-border">
                    <div class="description">
                        @if (item.Image == null)
                         {
                            <img class="program-avatar" src="~/Content/images/noPicture.png" />
                         }
                        else
                        {
                            <img class="program-avatar" src="@item.Image"/>
                        }
                        <hr />
                        <div><h5 style="text-align: center;">@item.Program_Name</h5></div>
                        <div class="description-program">
                            <p><strong>Cấp độ: </strong>@item.Level</p>
                            <p><strong>Buổi: </strong>@item.DurationWeeks</p>
                        </div>
                        <button class="btn-detail">
                            @Html.ActionLink("Xem chi tiết", "Detail", "Guest", new { id = item.Program_ID }, new { @class = "btn btn-default" })
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @*New Classes*@
    <div class="content">
        <div class="title-spacing"><h2>Lớp học mới mở</h2></div>
        <div class="blue-line"></div>
        <table class="table">
            <tr>
                <th>
                    Chương trình
                </th>
                <th>
                    Lớp
                </th>
                <th>
                    Số lượng
                </th>
                <th>
                    Còn lại
                </th>
                <th>
                    Thời gian khai giảng
                </th>
                <th>
                    Thời gian kết thúc
                </th>
                <th>
                    Đăng ký ngay
                </th>
            </tr>
            @foreach (var item in Model.ClassList)
            {
                if (item.StartDate > DateTime.Now)
                {
                    <tr>
                        <td>
                            @item.Program.Program_Name
                        </td>
                        <td>
                            @item.Class_Name
                        </td>
                        <td>
                            @item.MaxStudents
                        </td>
                        <td>
                            @(item.MaxStudents - item.CurrentStudents)
                        </td>
                        <td>
                            @item.StartDate.Value.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @item.EndDate.Value.ToString("dd/MM/yyyy")
                        </td>
                        <td class="pos">
                            @if ((item.MaxStudents - item.CurrentStudents) < 6)
                            {
                                <div class="register-btn-yellow">
                                    @Html.ActionLink("Đăng ký ngay", "User", "Register", new { @class = "btn btn-default" })
                                </div>
                            }
                            else
                            {
                                <div class="register-btn-green">
                                    @Html.ActionLink("Đăng ký ngay", "User", "Register", new { @class = "btn btn-default" })
                                </div>
                            }

                        </td>
                    </tr>
                }
            }
        </table>
    </div>

    @*Teachers*@
    <div class="content">
        <div class="title-spacing"><h2>Giáo viên tiêu biểu</h2></div>
        <div class="blue-line"></div>
        <div class="align-content-center">
            <div class="teacher-container"> 
                @foreach (var item in Model.TeachersList)
                {
                    <div class="teacher-info">
                        @if (item.UserAccount.Image == null)
                        {
                            <img class="teacher-avatar" src="~/Content/images/noPicture.png" />
                        }
                        else
                        {
                            <img class="teacher-avatar" src="@item.UserAccount.Image" />
                        }
                        <hr />
                        <p>@item.Teacher_Name</p>
                        <p>@item.Certificate</p>
                    </div>
                }
            </div>
        </div>
    </div>
</body>

<style>
    .header {
        display: flex;
        justify-content: center;
    }

    .banner {
        width: 100vw;
    }

    .content {
        display: flex;
        text-align: center;
        flex-direction: column;
        align-items: center;
        margin-top: 30px;
    }

    .blue-line {
        width: 100px;
        height: 5px;
        background-color: cornflowerblue;
        margin-top: 10px;
    }

    .introduce-1 {
        margin-top: 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-gap: 20px;
    }

    .introduce-2 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-gap: 20px;
        margin-top: 20px;
    }

    .introduce-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-gap: 20px;
        margin-top: 20px;
    }



    .introduce-picture {
        width: 100%;
        height: auto;
    }

    .introduce-border-banner {
        border-radius: 10px;
        border: 1px solid cornflowerblue;
        display: flex;
        align-items: center;
        flex-direction: column;
    }

    .introduce-picture-banner {
        width: 100%;
        height: auto;
        padding: 20px;
        border-radius: 150px;
    }

    .program-border {
        border-radius: 10px;
        border: 1px solid cornflowerblue;
        padding: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .program-border:hover {
        transform: translateY(-10px);
    }

    .program-border h4 {
        text-align: left;
    }

    .description {
        display: flex;
        justify-content: flex-start;
        flex-direction: column;
    }

        .description p {
            text-align: left;
            margin-bottom: 5px;
            padding-left: 10px;
        }

    .description h5 {
        color: cornflowerblue;
        text-align: left;
    }

    .btn-detail {
        border: 1px solid cornflowerblue;
        width: 100%;
        border-radius: 50px;
        display: flex;
        justify-content: center;
        background-color: cornflowerblue;
    }

    .btn-detail:hover {
        background-color: gray;
    }

    .btn-detail a {
        text-decoration: none;
        padding: 5px;
        color: white;
    }
    
    .register-btn-green {
        border-radius: 50px;
        border: 1px solid lightgreen;
        background-color: lightgreen;
        width: fit-content;
    }

    .register-btn-green:hover {
        background-color: gray;
        color: white;
    }

    .register-btn-yellow {
        border-radius: 50px;
        border: 1px solid yellow;
        background-color: yellow;
        width: fit-content;
    }

    .register-btn-yellow:hover {
        background-color: gray;
        color: white;
    }

    .pos {
        display: flex;
        justify-content: center;
    }

    .table {
        margin-top: 20px;
    }

    .teacher-container {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-gap: 10px;
        margin-top: 20px;
        align-items: center;
    }


    .teacher-info {
        border: 1px solid;
        padding: 10px;
    }

    body {
        margin: 0;
    }

    p {
        font-size: 18px;
    }

    h2 {
        color: cornflowerblue;
    }

    .introduce-border-banner h4 {
        color: cornflowerblue;
        text-align: center;
        padding: 20px;
    }

    .title-spacing {
        margin-top: 20px;
    }

    .teacher-avatar {
        width: 300px;
        height: 400px;
    }

    .program-avatar {
        width: 350px;
        height: 200px;
    }
    .description-program {
        margin-top: 10px;
    }
       
</style>

