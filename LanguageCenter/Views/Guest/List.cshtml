@model LanguageCenter.Models.Guest_ProgramListView
@using PagedList.Mvc
@{
    ViewBag.Title = "Program List";
}

<body>
    <div class="content">
        <h2>Chương trình tiếng anh</h2>
        <div class="blue-line"></div>
    </div>

    @using (Html.BeginForm("List", "Guest", FormMethod.Get))
    {
        <div class="filter">
            <div class="level-filter">
                <label>Cấp độ</label>
                <select name="levelFilter" onchange="this.form.submit()">
                    <option value="">Tất cả</option>
                    @foreach (var item in Model.LevelList)
                    {
                        <hr />
                        <option value="@item" @(Model.currentLevel == item ? "selected" : "")>@item</option>
                    }
                </select>
            </div>

            <div class="fee-filter">
                <label>Học phí</label>
                <select name="feeFilter" onchange="this.form.submit()">
                    <option value="">Tất cả</option>
                    <hr />
                    <option value="low" @(Model.currentFee == "low" ? "selected" : "")>Dưới 3 triệu</option>
                    <hr />
                    <option value="mid" @(Model.currentFee == "mid" ? "selected" : "")>Từ 3 - 6 triệu</option>
                    <hr />
                    <option value="high" @(Model.currentFee == "high" ? "selected" : "")>Trên 6 triệu</option>
                </select>
            </div>
        </div>
    }

    @if (Model.ProgramList != null)
    {
        <div class="introduce-3">
            @foreach (var item in Model.ProgramList)
            {
                <div class="program-border">
                    <div class="description">
                        @if (item.Image == null)
                        {
                            <img class="program-avatar" src="~/Content/images/noPicture.png" />
                        }
                        else
                        {
                            <img class="program-avatar" src="@item.Image" />
                        }
                        <hr />
                        <div><h5 style="text-align: center;">@item.Program_Name</h5></div>
                        <div class="detail">
                            <p><strong>Cấp độ: </strong>@item.Level</p>
                            <p><strong>Buổi: </strong>@item.DurationWeeks</p>
                            <p><strong>Học phí: </strong>@item.Price</p>
                        </div>
                        <button class="btn-detail">
                            @Html.ActionLink("Xem chi tiết", "ProgramList", new { @class = "btn btn-default" })
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</body>

<style>
    .content {
        display: flex;
        text-align: center;
        flex-direction: column;
        align-items: center;
        margin-top: 30px;
    }

    .blue-line {
        width: 100px;
        height: 5px;
        background-color: cornflowerblue;
        margin-top: 10px;
    }

    .filter {
        display: flex;
        gap: 20px;
    }

    .introduce-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-gap: 20px;
        margin-top: 20px;
    }

    .program-border {
        border-radius: 10px;
        border: 1px solid cornflowerblue;
        padding: 10px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .program-border:hover {
            transform: translateY(-10px);
        }

        .program-border h4 {
            text-align: left;
        }

    .description {
        display: flex;
        justify-content: flex-start;
        flex-direction: column;
    }

        .description p {
            text-align: left;
            margin-bottom: 5px;
        }

        .description h5 {
            color: cornflowerblue;
            text-align: left;
        }

    .program-avatar {
        width: 350px;
        height: 200px;
        align-self: center;
    }

    h2 {
        color: cornflowerblue;
    }

    .filter hr {
        width: 100%;
    }

    .btn-detail {
        border: 1px solid cornflowerblue;
        width: 100%;
        border-radius: 50px;
        display: flex;
        justify-content: center;
        background-color: cornflowerblue;
    }

        .btn-detail:hover {
            background-color: gray;
        }

        .btn-detail a {
            text-decoration: none;
            padding: 5px;
            color: white;
        }

    .detail {
        padding: 10px;
    }
</style>


@*PAGED LIST*@

<hr />

<div class="row" style="margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr 1fr; grid-gap: 10px;">
    @*<hr />*@
    <div class="col-md-6 col-lg-6 col-xs-6 col-sm-6">
        @using (Html.BeginForm("List", "Guest", FormMethod.Get))
        {
            <p>
                Size of page @Html.DropDownList("size", (List<SelectListItem>)ViewBag.size, new { @onchange = "this.form.submit();" })
            </p>
        }
    </div>

    <div class="MenuLayout">
        <div class="Menu">
            <a>@Html.PagedListPager(Model.ProgramList, page => Url.Action("List", new { page, size = ViewBag.currentSize }))</a>
        </div>
    </div>

    <div class="page-list-view" style="text-align: right; display: flex; justify-content: flex-end;">
        Page: @(Model.ProgramList.PageCount<Model.ProgramList.PageNumber? 0:Model.ProgramList.PageNumber)/@Model.ProgramList.PageCount
    </div>
</div>

@using (Html.BeginForm("List", "Guest", FormMethod.Get, new { @class = "from-inline" }))
{
    <div class="form-group form-inline" style="display: flex;">
        <input type="Text" class="form-control col-md-10" value="@ViewBag.Keyword" name="searchString" placeholder="Enter book title" />
        <input type="submit" class="btn btn-info" value="Search" style="margin-left: 10px;" />
    </div>
    <br />
}


<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script>
    $(document).ready(function () {
        var maxLength = 100;
        $(".show-read-more").each(function () {
            var myStr = $(this).text();
            if ($.trim(myStr).length > maxLength) {
                var newStr = myStr.substring(0, maxLength);
                var removedStr = myStr.substring(maxLength, $.trim(myStr).length);
                $(this).empty().html(newStr);
                $(this).append('<a href="javascript:void(0);" class="read-more">read continue...</a>');
                $(this).append('<span class="more-text" style="display:none;">' + removedStr + '</span>');
            }
        });
        $(".read-more").click(function () {
            $(this).siblings(".more-text").contents().unwrap();
            $(this).remove();
        });
    });
</script>

